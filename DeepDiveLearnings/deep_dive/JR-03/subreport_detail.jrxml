<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
     SUBREPORT: Well Detail for EC Facility Report
     Called by master_with_subreport.jrxml
     Parameter P_OBJECT_ID filters to one facility's wells
     ============================================================ -->
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="subreport_detail"
    pageWidth="782" pageHeight="595"
    columnWidth="782" leftMargin="0" rightMargin="0"
    topMargin="0" bottomMargin="0"
    whenNoDataType="NoData">

    <style name="Default" isDefault="true" fontName="Helvetica" fontSize="8"
           pdfFontName="Helvetica" isPdfEmbedded="false" pdfEncoding="Cp1252"/>

    <!-- Parameter passed from master -->
    <parameter name="P_FACILITY_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="P_DAYTIME" class="java.util.Date">
        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>

    <queryString language="sql">
        <![CDATA[
        SELECT
            o.object_code               AS well_code,
            o.name                      AS well_name,
            NVL(s.net_oil_vol_sm3, 0)  AS oil_vol,
            NVL(s.gas_vol_sm3, 0)       AS gas_vol,
            NVL(s.on_stream_hrs, 0)     AS on_stream_hrs
        FROM
            rv_pwel_day_status s
            JOIN object o ON o.object_id = s.object_id
        WHERE
            TRUNC(s.daytime) = TRUNC($P{P_DAYTIME})
            AND s.facility_id = (SELECT object_id FROM object WHERE object_code = $P{P_FACILITY_ID})
        ORDER BY
            o.object_code
        ]]>
    </queryString>

    <field name="well_code"     class="java.lang.String"/>
    <field name="well_name"     class="java.lang.String"/>
    <field name="oil_vol"       class="java.lang.Double"/>
    <field name="gas_vol"       class="java.lang.Double"/>
    <field name="on_stream_hrs" class="java.lang.Double"/>

    <!-- Variable exported back to master via returnValue -->
    <variable name="SUBTOTAL_OIL" class="java.lang.Double" calculation="Sum" resetType="Report">
        <variableExpression><![CDATA[$F{oil_vol}]]></variableExpression>
        <initialValueExpression><![CDATA[0.0]]></initialValueExpression>
    </variable>

    <title><band height="0"/></title>
    <pageHeader><band height="0"/></pageHeader>

    <columnHeader>
        <band height="14">
            <staticText>
                <reportElement x="10" y="1" width="120" height="12"/>
                <textElement><font isBold="true" pdfFontName="Helvetica-Bold" isPdfEmbedded="false" size="8"/></textElement>
                <text><![CDATA[Well Code]]></text>
            </staticText>
            <staticText>
                <reportElement x="130" y="1" width="200" height="12"/>
                <textElement><font isBold="true" pdfFontName="Helvetica-Bold" isPdfEmbedded="false" size="8"/></textElement>
                <text><![CDATA[Well Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="330" y="1" width="100" height="12"/>
                <textElement textAlignment="Right">
                    <font isBold="true" pdfFontName="Helvetica-Bold" isPdfEmbedded="false" size="8"/>
                </textElement>
                <text><![CDATA[Oil (SM3)]]></text>
            </staticText>
            <staticText>
                <reportElement x="430" y="1" width="100" height="12"/>
                <textElement textAlignment="Right">
                    <font isBold="true" pdfFontName="Helvetica-Bold" isPdfEmbedded="false" size="8"/>
                </textElement>
                <text><![CDATA[Gas (SM3)]]></text>
            </staticText>
            <staticText>
                <reportElement x="530" y="1" width="80" height="12"/>
                <textElement textAlignment="Right">
                    <font isBold="true" pdfFontName="Helvetica-Bold" isPdfEmbedded="false" size="8"/>
                </textElement>
                <text><![CDATA[On-Stream (h)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="12" splitType="Prevent">
            <textField>
                <reportElement x="10" y="1" width="120" height="10"/>
                <textFieldExpression><![CDATA[java.util.Objects.toString($F{well_code}, "")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="130" y="1" width="200" height="10"/>
                <textFieldExpression><![CDATA[java.util.Objects.toString($F{well_name}, "")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="1" width="100" height="10"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression>
                    <![CDATA[$F{oil_vol} != null ?
                        new java.text.DecimalFormat("#,##0.000").format($F{oil_vol}) : "0.000"]]>
                </textFieldExpression>
            </textField>
            <textField>
                <reportElement x="430" y="1" width="100" height="10"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression>
                    <![CDATA[$F{gas_vol} != null ?
                        new java.text.DecimalFormat("#,##0.000").format($F{gas_vol}) : "0.000"]]>
                </textFieldExpression>
            </textField>
            <textField>
                <reportElement x="530" y="1" width="80" height="10"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression>
                    <![CDATA[$F{on_stream_hrs} != null ?
                        new java.text.DecimalFormat("##0.0").format($F{on_stream_hrs}) : "0.0"]]>
                </textFieldExpression>
            </textField>
        </band>
    </detail>

    <columnFooter><band height="0"/></columnFooter>
    <pageFooter><band height="0"/></pageFooter>
    <lastPageFooter><band height="0"/></lastPageFooter>
    <summary><band height="0"/></summary>

    <noData>
        <band height="12">
            <staticText>
                <reportElement x="10" y="1" width="400" height="10"/>
                <textElement><font isItalic="true" pdfFontName="Helvetica-Oblique" isPdfEmbedded="false"/></textElement>
                <text><![CDATA[No wells found for this facility.]]></text>
            </staticText>
        </band>
    </noData>

</jasperReport>
