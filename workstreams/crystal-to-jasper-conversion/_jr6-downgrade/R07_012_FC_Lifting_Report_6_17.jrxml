    <queryString>
        <![CDATA[
        
SELECT DAYTIME,
       MAX(PROD_FORECAST) AS PRODUCTION,
       MAX(PROD_CLOSING_BALANCE) AS INVENTORY,
       NVL(MAX(TOTAL_LIFTED_QTY), 0) AS LIFTED_QTY,
       NVL(MAX(CASE WHEN COMPANY_CODE = 'INPEX_ICHTHYS' THEN LIFTED_QTY END), 0) AS INPEX_QTY,
       NVL(MAX(CASE WHEN COMPANY_CODE = 'TOTAL_ICHTHYS' THEN LIFTED_QTY END), 0) AS TOTAL_QTY,
       NVL(MAX(CASE WHEN COMPANY_CODE = 'CPC_ICHTHYS' THEN LIFTED_QTY END), 0) AS OPIC_QTY,
       NVL(MAX(CASE WHEN COMPANY_CODE = 'OSAKA_GAS_ICHTHYS' THEN LIFTED_QTY END), 0) AS OSAKA_QTY,
       NVL(MAX(CASE WHEN COMPANY_CODE = 'KANSAI_ELECTRIC_ICHTHYS' THEN LIFTED_QTY END), 0) AS KANSAI_QTY,
       NVL(MAX(CASE WHEN COMPANY_CODE = 'CHUBU_ELECTRIC_ICHTHYS' THEN LIFTED_QTY END), 0) AS JERA_QTY,
       NVL(MAX(CASE WHEN COMPANY_CODE = 'TOHO_GAS_ICHTHYS' THEN LIFTED_QTY END), 0) AS TOHO_QTY,
       MAX(CARGO_NAME) AS CARGO_NAME,
       MAX(CARRIER_NAME) AS VESSEL,
       MAX(CARGO_STATUS) AS LIFTING_STATUS
  FROM TV_FC_LIFTING_REPORT
 WHERE DAYTIME BETWEEN TRUNC($P{P_START_DATE}, 'MM') AND LAST_DAY($P{P_END_DATE})
 GROUP BY DAYTIME
 ORDER BY DAYTIME
        
    ]]>
    </queryString>

