    <pageFooter>
        <band height="24" splitType="Stretch">
            <textField isBlankWhenNull="true">
                <reportElement style="FootnoteStyle" x="0" y="0" width="1140" height="12"/>
                <textElement textAlignment="Left"/>
                <textFieldExpression><![CDATA[$P{P_DISCLAIMER_TEXT}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="13" width="1140" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.5" lineColor="#454087"/>
                </graphicElement>
            </line>
            <textField pattern="dd-MMM-yyyy HH:mm.ss" evaluationTime="Report">
                <reportElement style="FooterStripStyle" x="0" y="17" width="200" height="7"/>
                <textElement textAlignment="Left"/>
                <textFieldExpression><![CDATA["Last refresh date: " + new java.text.SimpleDateFormat("dd-MMM-yyyy HH:mm.ss").format($P{P_LAST_REFRESH})]]></textFieldExpression>
            </textField>
            <staticText>
