        <conditionalStyle conditionExpression="$F{LIFTED_QTY} != null &amp;&amp; $F{LIFTED_QTY}.doubleValue() == 0.0" forecolor="#FFFFFF"/>
    </style>
    <style name="InpexZeroStyle" forecolor="#000000" fontName="Arial" fontSize="8.0">
