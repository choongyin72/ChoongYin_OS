    </variable>
    <variable name="V_OSAKA_TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <expression><![CDATA[$F{OSAKA_QTY}]]></expression>
    </variable>
    <variable name="V_KANSAI_TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <expression><![CDATA[$F{KANSAI_QTY}]]></expression>
    </variable>
    <variable name="V_JERA_TOTAL" class="java.math.BigDecimal" calculation="Sum">
