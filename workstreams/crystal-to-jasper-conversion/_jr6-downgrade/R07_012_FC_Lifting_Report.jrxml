    <style name="TohoZeroStyle" forecolor="#000000" fontName="Arial" fontSize="8.0">
        <box rightPadding="3"><topPen lineWidth="1.0" lineColor="#D6D6D6"/><bottomPen lineWidth="1.0" lineColor="#D6D6D6"/><rightPen lineWidth="1.0" lineColor="#D6D6D6"/></box>
        <conditionalStyle conditionExpression="$F{TOHO_QTY} != null &amp;&amp; $F{TOHO_QTY}.doubleValue() == 0.0" forecolor="#FFFFFF"/>
    </style>

    <!-- P_REPORT_DATE drives the reporting month. It MUST be declared before P_START_DATE
         and P_END_DATE, because a defaultValueExpression can only reference parameters
         declared earlier in the file. Both date parameters parse this one value; the month
         boundaries are derived in the query with Oracle's own TRUNC(x,'MM') / LAST_DAY(x),
         matching queries/R07.012_FC_LIFT_Subqueries.sql line 24. So any date within a month
         yields that whole month. -->
    <parameter name="P_REPORT_DATE" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["2025-07-01T00:00:00"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_START_DATE" class="java.sql.Timestamp" forPrompting="false">
        <defaultValueExpression><![CDATA[new java.sql.Timestamp(new java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss").parse($P{P_REPORT_DATE}).getTime())]]></defaultValueExpression>
    </parameter>
    <parameter name="P_END_DATE" class="java.sql.Timestamp" forPrompting="false">
        <defaultValueExpression><![CDATA[new java.sql.Timestamp(new java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss").parse($P{P_REPORT_DATE}).getTime())]]></defaultValueExpression>
    </parameter>
    <parameter name="P_OPENING_INVENTORY" class="java.math.BigDecimal" forPrompting="false">
        <defaultValueExpression><![CDATA[new java.math.BigDecimal("323715.028671")]]></defaultValueExpression>
    </parameter>
    <parameter name="P_DISCLAIMER_TEXT" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["* Production is reconciled to Inventory and Liftings at month-end. Daily Inventory measurements are not reconciled."]]></defaultValueExpression>
    </parameter>
    <parameter name="P_PUBLISH_DATE" class="java.sql.Timestamp" forPrompting="false">
        <defaultValueExpression><![CDATA[new java.sql.Timestamp(new java.text.SimpleDateFormat("yyyy-MM-dd").parse("2025-08-05").getTime())]]></defaultValueExpression>
    </parameter>
    <parameter name="P_LAST_REFRESH" class="java.sql.Timestamp" forPrompting="false">
        <defaultValueExpression><![CDATA[new java.sql.Timestamp(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").parse("2025-08-05 08:19:03").getTime())]]></defaultValueExpression>
    </parameter>
    <!-- Base folder for relative resources, TRAILING SEPARATOR INCLUDED. "./" resolves to the
         current absolute directory at run time; kept relative rather than a hardcoded absolute
         path so it stays environment-independent. Point it at another folder to load the logo
         from there. Consumed by the title band's image element as $P{P_BASE_URL} + "logo.png",
         so any replacement value must also end in "/". -->
    <parameter name="P_BASE_URL" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["/extension/ZREP/reports/"]]></defaultValueExpression>
    </parameter>
    <!-- Superseded by the P_BASE_URL concatenation above and no longer referenced by any
         element. Left declared so any caller already passing it does not break. -->
    <parameter name="P_LOGO_PATH" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_LBL_INPEX" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["INPEX"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_LBL_TOTAL" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["TOTAL"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_LBL_OPIC" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["OPIC"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_LBL_OSAKA" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["Osaka Gas"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_LBL_KANSAI" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["Kansai Electric"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_LBL_JERA" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["JERA"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_LBL_TOHO" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["Toho Gas"]]></defaultValueExpression>
    </parameter>

    <query language="sql">
        <![CDATA[
SELECT DAYTIME,
       MAX(PROD_FORECAST) AS PRODUCTION,
       MAX(PROD_CLOSING_BALANCE) AS INVENTORY,
       NVL(MAX(TOTAL_LIFTED_QTY), 0) AS LIFTED_QTY,
       NVL(MAX(CASE WHEN COMPANY_CODE = 'INPEX_ICHTHYS' THEN LIFTED_QTY END), 0) AS INPEX_QTY,
       NVL(MAX(CASE WHEN COMPANY_CODE = 'TOTAL_ICHTHYS' THEN LIFTED_QTY END), 0) AS TOTAL_QTY,
       NVL(MAX(CASE WHEN COMPANY_CODE = 'CPC_ICHTHYS' THEN LIFTED_QTY END), 0) AS OPIC_QTY,
       NVL(MAX(CASE WHEN COMPANY_CODE = 'OSAKA_GAS_ICHTHYS' THEN LIFTED_QTY END), 0) AS OSAKA_QTY,
       NVL(MAX(CASE WHEN COMPANY_CODE = 'KANSAI_ELECTRIC_ICHTHYS' THEN LIFTED_QTY END), 0) AS KANSAI_QTY,
       NVL(MAX(CASE WHEN COMPANY_CODE = 'CHUBU_ELECTRIC_ICHTHYS' THEN LIFTED_QTY END), 0) AS JERA_QTY,
       NVL(MAX(CASE WHEN COMPANY_CODE = 'TOHO_GAS_ICHTHYS' THEN LIFTED_QTY END), 0) AS TOHO_QTY,
       MAX(CARGO_NAME) AS CARGO_NAME,
       MAX(CARRIER_NAME) AS VESSEL,
       MAX(CARGO_STATUS) AS LIFTING_STATUS
  FROM TV_FC_LIFTING_REPORT
 WHERE DAYTIME BETWEEN TRUNC($P{P_START_DATE}, 'MM') AND LAST_DAY($P{P_END_DATE})
 GROUP BY DAYTIME
 ORDER BY DAYTIME
        ]]>
    </query>

    <field name="DAYTIME" class="java.sql.Timestamp"/>
    <field name="PRODUCTION" class="java.math.BigDecimal"/>
    <field name="INVENTORY" class="java.math.BigDecimal"/>
    <field name="LIFTED_QTY" class="java.math.BigDecimal"/>
    <field name="INPEX_QTY" class="java.math.BigDecimal"/>
    <field name="TOTAL_QTY" class="java.math.BigDecimal"/>
    <field name="OPIC_QTY" class="java.math.BigDecimal"/>
    <field name="OSAKA_QTY" class="java.math.BigDecimal"/>
    <field name="KANSAI_QTY" class="java.math.BigDecimal"/>
    <field name="JERA_QTY" class="java.math.BigDecimal"/>
    <field name="TOHO_QTY" class="java.math.BigDecimal"/>
    <field name="CARGO_NAME" class="java.lang.String"/>
    <field name="VESSEL" class="java.lang.String"/>
    <field name="LIFTING_STATUS" class="java.lang.String"/>

    <variable name="V_PRODUCTION_TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <expression><![CDATA[$F{PRODUCTION}]]></expression>
    </variable>
    <variable name="V_LIFTED_QTY_TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <expression><![CDATA[$F{LIFTED_QTY}]]></expression>
    </variable>
    <variable name="V_INPEX_TOTAL" class="java.math.BigDecimal" calculation="Sum">
