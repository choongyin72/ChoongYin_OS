    <style name="OsakaZeroStyle" forecolor="#000000" fontName="Arial" fontSize="8.0">
        <box rightPadding="3"><topPen lineWidth="1.0" lineColor="#D6D6D6"/><bottomPen lineWidth="1.0" lineColor="#D6D6D6"/><rightPen lineWidth="1.0" lineColor="#D6D6D6"/></box>
