    <!-- P_REPORT_DATE drives the reporting month. It MUST be declared before P_START_DATE
         and P_END_DATE, because a defaultValueExpression can only reference parameters
         declared earlier in the file. Both date parameters parse this one value; the month
         boundaries are derived in the query with Oracle's own TRUNC(x,'MM') / LAST_DAY(x),
         matching queries/R07.012_FC_LIFT_Subqueries.sql line 24. So any date within a month
         yields that whole month. -->
    <parameter name="P_REPORT_DATE" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["2025-07-01T00:00:00"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_START_DATE" class="java.sql.Timestamp" forPrompting="false">
        <defaultValueExpression><![CDATA[new java.sql.Timestamp(new java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss").parse($P{P_REPORT_DATE}).getTime())]]></defaultValueExpression>
    </parameter>
    <parameter name="P_END_DATE" class="java.sql.Timestamp" forPrompting="false">
        <defaultValueExpression><![CDATA[new java.sql.Timestamp(new java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss").parse($P{P_REPORT_DATE}).getTime())]]></defaultValueExpression>
    </parameter>
    <parameter name="P_OPENING_INVENTORY_PROPANE" class="java.math.BigDecimal" forPrompting="false">
        <defaultValueExpression><![CDATA[new java.math.BigDecimal("83742.5211")]]></defaultValueExpression>
    </parameter>
    <parameter name="P_OPENING_INVENTORY_BUTANE" class="java.math.BigDecimal" forPrompting="false">
        <defaultValueExpression><![CDATA[new java.math.BigDecimal("56181.531")]]></defaultValueExpression>
    </parameter>
    <parameter name="P_DISCLAIMER_TEXT" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["* Production is reconciled to Inventory and Liftings at month-end. Daily Inventory measurements are not reconciled."]]></defaultValueExpression>
    </parameter>
    <parameter name="P_PUBLISH_DATE" class="java.sql.Timestamp" forPrompting="false">
        <defaultValueExpression><![CDATA[new java.sql.Timestamp(new java.text.SimpleDateFormat("yyyy-MM-dd").parse("2025-08-05").getTime())]]></defaultValueExpression>
    </parameter>
    <parameter name="P_LAST_REFRESH" class="java.sql.Timestamp" forPrompting="false">
        <defaultValueExpression><![CDATA[new java.sql.Timestamp(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").parse("2025-08-05 12:48:13").getTime())]]></defaultValueExpression>
    </parameter>
    <!-- Base folder for relative resources, TRAILING SEPARATOR INCLUDED. "./" resolves to the
         current absolute directory at run time; kept relative rather than a hardcoded absolute
         path so it stays environment-independent. Point it at another folder to load the logo
         from there. Consumed by the title band's image element as $P{P_BASE_URL} + "logo.png",
         so any replacement value must also end in "/". -->
    <parameter name="P_BASE_URL" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["/extension/ZREP/reports/"]]></defaultValueExpression>
    </parameter>
    <!-- Superseded by the P_BASE_URL concatenation above and no longer referenced by any
         element. Left declared so any caller already passing it does not break. -->	
    <parameter name="P_LOGO_PATH" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_LBL_INPEX" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["INPEX"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_LBL_TOTAL" class="java.lang.String" forPrompting="false">
        <defaultValueExpression><![CDATA["TOTAL"]]></defaultValueExpression>
    </parameter>

    <query language="sql">
        <![CDATA[
SELECT DAYTIME,
       MAX(CASE WHEN STORAGE_CODE = 'PROPANE' THEN PROD_FORECAST END) AS PRODUCTION_PROPANE,
       MAX(CASE WHEN STORAGE_CODE = 'BUTANE'  THEN PROD_FORECAST END) AS PRODUCTION_BUTANE,
       MAX(CASE WHEN STORAGE_CODE = 'PROPANE' THEN PROD_CLOSING_BALANCE END) AS INVENTORY_PROPANE,
       MAX(CASE WHEN STORAGE_CODE = 'BUTANE'  THEN PROD_CLOSING_BALANCE END) AS INVENTORY_BUTANE,
       NVL(MAX(CASE WHEN STORAGE_CODE = 'PROPANE' AND COMPANY_CODE = 'INPEX_TRADING'      THEN LIFTED_QTY END), 0) AS LIFT_INPEX_PROPANE,
       NVL(MAX(CASE WHEN STORAGE_CODE = 'BUTANE'  AND COMPANY_CODE = 'INPEX_TRADING'      THEN LIFTED_QTY END), 0) AS LIFT_INPEX_BUTANE,
       NVL(MAX(CASE WHEN STORAGE_CODE = 'PROPANE' AND COMPANY_CODE = 'TOTAL_TRADING_ASIA' THEN LIFTED_QTY END), 0) AS LIFT_TOTAL_PROPANE,
       NVL(MAX(CASE WHEN STORAGE_CODE = 'BUTANE'  AND COMPANY_CODE = 'TOTAL_TRADING_ASIA' THEN LIFTED_QTY END), 0) AS LIFT_TOTAL_BUTANE,
       NVL(MAX(CASE WHEN STORAGE_CODE = 'PROPANE' AND COMPANY_CODE = 'INPEX_TRADING'      THEN LIFTED_QTY_UNIT2 END), 0) AS LIFTMT_INPEX_PROPANE,
       NVL(MAX(CASE WHEN STORAGE_CODE = 'BUTANE'  AND COMPANY_CODE = 'INPEX_TRADING'      THEN LIFTED_QTY_UNIT2 END), 0) AS LIFTMT_INPEX_BUTANE,
       NVL(MAX(CASE WHEN STORAGE_CODE = 'PROPANE' AND COMPANY_CODE = 'TOTAL_TRADING_ASIA' THEN LIFTED_QTY_UNIT2 END), 0) AS LIFTMT_TOTAL_PROPANE,
       NVL(MAX(CASE WHEN STORAGE_CODE = 'BUTANE'  AND COMPANY_CODE = 'TOTAL_TRADING_ASIA' THEN LIFTED_QTY_UNIT2 END), 0) AS LIFTMT_TOTAL_BUTANE,
       MAX(CARGO_NAME)    AS CARGO_NAME,
       MAX(CARRIER_NAME)  AS VESSEL,
       MAX(CARGO_STATUS)  AS LIFTING_STATUS
  FROM TV_LPG_LIFTING_REPORT
 WHERE DAYTIME BETWEEN TRUNC($P{P_START_DATE}, 'MM') AND LAST_DAY($P{P_END_DATE})
 GROUP BY DAYTIME
 ORDER BY DAYTIME
        ]]>
    </query>

    <field name="DAYTIME" class="java.sql.Timestamp"/>
    <field name="PRODUCTION_PROPANE" class="java.math.BigDecimal"/>
    <field name="PRODUCTION_BUTANE" class="java.math.BigDecimal"/>
    <field name="INVENTORY_PROPANE" class="java.math.BigDecimal"/>
    <field name="INVENTORY_BUTANE" class="java.math.BigDecimal"/>
    <field name="LIFT_INPEX_PROPANE" class="java.math.BigDecimal"/>
    <field name="LIFT_INPEX_BUTANE" class="java.math.BigDecimal"/>
    <field name="LIFT_TOTAL_PROPANE" class="java.math.BigDecimal"/>
    <field name="LIFT_TOTAL_BUTANE" class="java.math.BigDecimal"/>
    <field name="LIFTMT_INPEX_PROPANE" class="java.math.BigDecimal"/>
    <field name="LIFTMT_INPEX_BUTANE" class="java.math.BigDecimal"/>
    <field name="LIFTMT_TOTAL_PROPANE" class="java.math.BigDecimal"/>
    <field name="LIFTMT_TOTAL_BUTANE" class="java.math.BigDecimal"/>
    <field name="CARGO_NAME" class="java.lang.String"/>
    <field name="VESSEL" class="java.lang.String"/>
    <field name="LIFTING_STATUS" class="java.lang.String"/>

    <variable name="V_PRODUCTION_PROPANE_TOTAL" class="java.math.BigDecimal" calculation="Sum">
