    <variable name="V_LIFTMT_TOTAL_BUTANE_TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <expression><![CDATA[$F{LIFTMT_TOTAL_BUTANE}]]></expression>
    </variable>

