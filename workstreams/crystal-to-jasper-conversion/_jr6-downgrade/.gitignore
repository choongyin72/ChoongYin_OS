# Reproducible build outputs - not committed.
#
# jr6170-lib/ is 19 jars (~30MB) fetched by Maven from the pinned pom.xml. Recreate with:
#     mvn -q dependency:copy-dependencies -DoutputDirectory=jr6170-lib
# classes/ is javac output for Jr6Build/SqlQ, recreated on every jr6build.sh run.
jr6170-lib/
classes/

# Rendered comparison artifacts - regenerated by verify_jr6.py
CMP_*.png

# Per-report harness staging + compiled classes + fail.log, rebuilt by every test_all.py run.
_testwork/

# Local safety copies taken before an edit. Kept on disk deliberately (never deleted), but
# they are point-in-time snapshots of files already under version control, so not committed.
*.backup_*
